# Documentation only: set these as environment variables before starting.
FITNESS_DB_PATH=data/runtime/fitness.sqlite3
FITNESS_COOKIE_SECURE=false
# Keep local until an explicitly approved HTTPS deployment is ready.
FITNESS_ACCESS_MODE=local
FITNESS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FITNESS_PUBLIC_ORIGIN=
# Registration and guest access can be enabled independently over shared HTTPS.
FITNESS_REGISTRATION_ENABLED=true
FITNESS_GUEST_ENABLED=true
FITNESS_GUEST_AI_DAILY_LIMIT=20
# Opt in to text parsing only by setting this to qwen.
FITNESS_MODEL_PROVIDER=disabled
FITNESS_QWEN_MODEL=qwen3.7-plus
# Beijing endpoint. Use the official endpoint matching your key's region.
FITNESS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set privately on this computer; never commit or send a real key in chat.
DASHSCOPE_API_KEY=
# Audio uses the same server-held key; opt in independently.
FITNESS_SPEECH_ENABLED=false
FITNESS_QWEN_ASR_MODEL=qwen3-asr-flash
# Photos are sent only after the user requests recognition, never stored as files.
FITNESS_PHOTO_ENABLED=false
FITNESS_QWEN_VISION_MODEL=qwen3.7-plus
# Nutrition estimates reuse the text model, with an independent opt-in.
FITNESS_NUTRITION_ENABLED=false
# Training parsing and calorie estimates reuse the text model, independently enabled.
FITNESS_WORKOUT_ENABLED=false
# Reviewed-knowledge Q&A has its own opt-in; browsing/search remains free.
FITNESS_KNOWLEDGE_QA_ENABLED=false
# Next-meal drafts, independently enabled; never writes actual meal records.
FITNESS_MEAL_PLAN_ENABLED=false
FITNESS_TRAINING_PLAN_ENABLED=false
# Free-text coach understanding is a separate opt-in and never applies itself.
FITNESS_COACH_ENABLED=false
# Combined text + speech + estimates + knowledge Q&A + plans + coach per UTC day.
# Zero disables paid calls.
FITNESS_AI_USER_DAILY_LIMIT=100
FITNESS_AI_GLOBAL_DAILY_LIMIT=100
